# 版本控制与本地工具缓存
.git
.gitignore
.github
.vscode
.pytest_cache
.ruff_cache
.pycache
.claude

# Python 运行产物
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# 前端依赖与构建产物（镜像内会重新 npm ci + build）
frontend/node_modules/
frontend/dist/
frontend/build/
