# 运行期数据与产物（由数据卷提供，不进镜像）
data/uploads/
data/results/
data/output/
data/temp/
data/input/
data/*.db
logs/
output/
output_final/
marker_output/
BookTrans/

# 密钥与本地环境
.env
.env.local

# 文档与设计稿（运行时不需要）
design-preview/
docs/
*.md
!README.md

# 杂项
.DS_Store
*.log
*.pid
