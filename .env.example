# 复制为 .env 后填入真实密钥：cp .env.example .env
# docker compose 会自动读取本目录下的 .env 进行变量注入。

# 主 API：DeepSeek V3 via SiliconFlow（必填）
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here

# 备用 API：OpenAI 兼容端点（可选，与 SILICONFLOW_API_KEY 二选一）
# OPENAI_API_KEY=sk-your-openai-key-here

# 备用 API：Google Gemini（可选，评测裁判等场景使用）
# GOOGLE_API_KEY=AIzaSy-your-google-key-here
